{
  "name": "personal_work_space",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "comment": "The build scripts are .mts run by node directly, which needs the type stripping that became unflagged in 22.18.",
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "rm -rf .next out cv/build public/cv.pdf public/cv",
    "setup": "npm run clean && npm install && npm run cv:tex && node scripts/build-cv-pdf.mts --optional && node scripts/publish-cv-pdf.mts --optional && node scripts/build-cv-images.mts --optional",
    "predev": "npm run setup",
    "dev": "next dev",
    "predev:open": "npm run setup",
    "dev:open": "(until curl -sf -o /dev/null http://localhost:3000; do sleep 0.5; done; open http://localhost:3000) & next dev",
    "build": "next build",
    "preview": "npm run build && npx --yes serve@latest out",
    "lint": "eslint",
    "cv:tex": "node scripts/build-cv-tex.mts",
    "cv:pdf": "npm run cv:tex && node scripts/build-cv-pdf.mts && node scripts/publish-cv-pdf.mts && node scripts/build-cv-images.mts",
    "effects:sync": "node scripts/sync-effects.mts",
    "docs:sync": "node scripts/sync-docs.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "commits:check": "node scripts/check-commit-message.mts --range"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "jsdom": "^30.0.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  }
}
