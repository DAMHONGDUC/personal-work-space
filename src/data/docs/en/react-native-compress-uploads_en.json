    {
      "id": "cleanup",
      "title": "Clean up the cache",
      "blocks": [
        {
          "type": "code",
          "language": "typescript",
          "caption": "Run it after the upload, success or not",
          "code": [
            "const destPath = `${RNFetchBlob.fs.dirs.CacheDir}/${fileName}`;",
            "if (await RNFetchBlob.fs.exists(destPath)) {",
            "  await RNFetchBlob.fs.unlink(destPath);",
            "}"
          ]
        }
      ]
