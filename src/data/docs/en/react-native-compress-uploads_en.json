    {
      "id": "images",
      "title": "Images",
      "summary": "One library, both platforms.",
      "blocks": [
        {
          "type": "code",
          "language": "typescript",
          "caption": "Pick and copy into the cache",
          "code": [
            "const uri = Platform.OS === 'ios'",
            "  ? file.uri.replace('file://', '')",
            "  : file.uri;",
            "",
            "const destPath = `${RNFetchBlob.fs.dirs.CacheDir}/${file.name}`;",
            "await RNFetchBlob.fs.cp(uri, destPath);"
          ]
        },
        {
          "type": "code",
          "language": "typescript",
          "caption": "Compress, then upload result",
          "code": [
            "const result = await Image.compress(destPath, {",
            "  maxWidth: 1000,",
            "  maxHeight: 1000,",
            "  quality: 0.5,",
            "});"
          ]
        },
        {
