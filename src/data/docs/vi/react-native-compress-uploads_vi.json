    {
      "id": "video-android",
      "title": "Video trên Android",
      "summary": "Một native module, gọi từ JavaScript.",
      "blocks": [
        {
          "type": "steps",
          "items": [
            "Thêm implementation 'com.github.MasayukiSuda:Mp4Composer-android:v0.4.1' vào android/app/build.gradle.",
            "Thêm module bên dưới và đăng ký nó trong một ReactPackage.",
            "Truyền input dạng content:// và output path nằm trong CacheDir.",
            "Đợi promise xong rồi mới upload file output."
          ]
        },
        {
          "type": "code",
          "language": "java",
          "caption": "Module, đặt trong package của app bạn",
          "code": [
            "public class CompressVideoModule extends ReactContextBaseJavaModule {",
            "    private final Context appContext;",
            "",
            "    CompressVideoModule(ReactApplicationContext context) {",
            "        super(context);",
            "        this.appContext = context;",
            "    }",
            "",
            "    @Override",
            "    public String getName() {",
            "        return \"CompressVideoModule\";",
            "    }",
            "",
            "    private long getDurationUs(String inputPath) {",
            "        MediaExtractor extractor = new MediaExtractor();",
            "        try {",
            "            extractor.setDataSource(appContext, Uri.parse(inputPath), null);",
            "            for (int i = 0; i < extractor.getTrackCount(); ++i) {",
            "                MediaFormat format = extractor.getTrackFormat(i);",
            "                if (format.getString(MediaFormat.KEY_MIME).startsWith(\"video/\")",
            "                        && format.containsKey(MediaFormat.KEY_DURATION)) {",
            "                    return format.getLong(MediaFormat.KEY_DURATION);",
            "                }",
            "            }",
            "        } catch (IOException e) {",
            "            Log.w(\"CompressVideo\", \"could not read duration\", e);",
            "        } finally {",
            "            extractor.release();",
            "        }",
            "        return 0;",
            "    }",
            "",
            "    @ReactMethod",
            "    public void compress(String inputPath, String outputPath, int width, int height,",
            "                         float quality, Promise promise) {",
            "        try {",
            "            AssetFileDescriptor fd = appContext.getContentResolver()",
            "                    .openAssetFileDescriptor(Uri.parse(inputPath), \"r\");",
            "            long fileSize = fd.getLength();",
            "            long durationUs = getDurationUs(inputPath);",
            "",
            "            // Fall back to a rule-of-thumb bitrate when size or duration is unknown.",
            "            float bitrate = 0.25f * 30 * width * height;",
            "            if (fileSize != 0 && durationUs != 0) {",
            "                bitrate = ((float) fileSize / durationUs) * 8 * 1_000_000;",
            "            }",
            "",
            "            new Mp4Composer(Uri.parse(inputPath), outputPath, appContext)",
            "                    .size(width, height)",
            "                    .videoBitrate((int) (bitrate * quality))",
            "                    .listener(new Mp4Composer.Listener() {",
            "                        @Override public void onProgress(double progress) {}",
            "                        @Override public void onCurrentWrittenVideoTime(long timeUs) {}",
            "                        @Override public void onCompleted() { promise.resolve(outputPath); }",
            "                        @Override public void onCanceled() { promise.reject(\"CANCELED\", \"compression canceled\"); }",
            "                        @Override public void onFailed(Exception e) { promise.reject(\"FAILED\", e); }",
            "                    })",
            "                    .start();",
            "        } catch (Exception e) {",
            "            promise.reject(\"FAILED\", e);",
            "        }",
            "    }",
            "}"
          ]
        },
        {
          "type": "code",
          "language": "typescript",
          "caption": "width, height, rồi quality từ 0 đến 1",
          "code": [
            "const { CompressVideoModule } = NativeModules;",
            "",
            "await CompressVideoModule.compress(inputPath, destPath, 540, 960, 0.5);"
          ]
        },
        {
          "type": "note",
          "tone": "warning",
          "body": [
            "Mp4Composer chạy nền. Bản đầu của module này trả về ngay lập tức, nên việc upload bắt đầu trên một file mới ghi được một nửa; hãy resolve Promise trong onCompleted."
          ]
        },
